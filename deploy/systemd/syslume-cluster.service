[Unit]
Description=SysLume cluster dashboard + history + API
After=network-online.target syslume-collector.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/pi-agent/syslume-cluster-repo
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m cluster.app --config %h/.config/syslume/app.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=default.target
